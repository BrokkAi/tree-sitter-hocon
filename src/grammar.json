{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "hocon",
  "rules": {
    "document": {
      "type": "CHOICE",
      "members": [
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "object"
            },
            {
              "type": "SYMBOL",
              "name": "array"
            },
            {
              "type": "SYMBOL",
              "name": "_fields"
            }
          ]
        },
        {
          "type": "BLANK"
        }
      ]
    },
    "comment": {
      "type": "TOKEN",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "SEQ",
            "members": [
              {
                "type": "STRING",
                "value": "//"
              },
              {
                "type": "PATTERN",
                "value": "[^\\n]*"
              }
            ]
          },
          {
            "type": "SEQ",
            "members": [
              {
                "type": "STRING",
                "value": "#"
              },
              {
                "type": "PATTERN",
                "value": "[^\\n]*"
              }
            ]
          }
        ]
      }
    },
    "_fields": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_member"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SEQ",
            "members": [
              {
                "type": "SYMBOL",
                "name": "_separator"
              },
              {
                "type": "SYMBOL",
                "name": "_member"
              }
            ]
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "_separator"
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "_member": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "field"
        },
        {
          "type": "SYMBOL",
          "name": "include"
        }
      ]
    },
    "_separator": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SEQ",
          "members": [
            {
              "type": "STRING",
              "value": ","
            },
            {
              "type": "CHOICE",
              "members": [
                {
                  "type": "SYMBOL",
                  "name": "_newline"
                },
                {
                  "type": "BLANK"
                }
              ]
            }
          ]
        },
        {
          "type": "SEQ",
          "members": [
            {
              "type": "SYMBOL",
              "name": "_newline"
            },
            {
              "type": "CHOICE",
              "members": [
                {
                  "type": "SEQ",
                  "members": [
                    {
                      "type": "STRING",
                      "value": ","
                    },
                    {
                      "type": "CHOICE",
                      "members": [
                        {
                          "type": "SYMBOL",
                          "name": "_newline"
                        },
                        {
                          "type": "BLANK"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "BLANK"
                }
              ]
            }
          ]
        }
      ]
    },
    "field": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "key",
          "content": {
            "type": "SYMBOL",
            "name": "path"
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "FIELD",
                  "name": "operator",
                  "content": {
                    "type": "CHOICE",
                    "members": [
                      {
                        "type": "STRING",
                        "value": ":"
                      },
                      {
                        "type": "STRING",
                        "value": "="
                      },
                      {
                        "type": "STRING",
                        "value": "+="
                      }
                    ]
                  }
                },
                {
                  "type": "FIELD",
                  "name": "value",
                  "content": {
                    "type": "SYMBOL",
                    "name": "value"
                  }
                }
              ]
            },
            {
              "type": "FIELD",
              "name": "value",
              "content": {
                "type": "ALIAS",
                "content": {
                  "type": "SYMBOL",
                  "name": "_object_value"
                },
                "named": true,
                "value": "value"
              }
            }
          ]
        }
      ]
    },
    "object": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "{"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "_fields"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "STRING",
          "value": "}"
        }
      ]
    },
    "array": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "["
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "SYMBOL",
                  "name": "value"
                },
                {
                  "type": "REPEAT",
                  "content": {
                    "type": "SEQ",
                    "members": [
                      {
                        "type": "SYMBOL",
                        "name": "_separator"
                      },
                      {
                        "type": "SYMBOL",
                        "name": "value"
                      }
                    ]
                  }
                },
                {
                  "type": "CHOICE",
                  "members": [
                    {
                      "type": "SYMBOL",
                      "name": "_separator"
                    },
                    {
                      "type": "BLANK"
                    }
                  ]
                }
              ]
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "STRING",
          "value": "]"
        }
      ]
    },
    "value": {
      "type": "REPEAT1",
      "content": {
        "type": "SYMBOL",
        "name": "_piece"
      }
    },
    "_object_value": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "object"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_piece"
          }
        }
      ]
    },
    "_piece": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "object"
        },
        {
          "type": "SYMBOL",
          "name": "array"
        },
        {
          "type": "SYMBOL",
          "name": "string"
        },
        {
          "type": "SYMBOL",
          "name": "multiline_string"
        },
        {
          "type": "SYMBOL",
          "name": "number"
        },
        {
          "type": "SYMBOL",
          "name": "true"
        },
        {
          "type": "SYMBOL",
          "name": "false"
        },
        {
          "type": "SYMBOL",
          "name": "null"
        },
        {
          "type": "SYMBOL",
          "name": "substitution"
        },
        {
          "type": "SYMBOL",
          "name": "unquoted_string"
        }
      ]
    },
    "path": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "path_element"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SEQ",
            "members": [
              {
                "type": "IMMEDIATE_TOKEN",
                "content": {
                  "type": "STRING",
                  "value": "."
                }
              },
              {
                "type": "SYMBOL",
                "name": "path_element"
              }
            ]
          }
        }
      ]
    },
    "path_element": {
      "type": "PREC_RIGHT",
      "value": 0,
      "content": {
        "type": "REPEAT1",
        "content": {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "unquoted_key"
            },
            {
              "type": "SYMBOL",
              "name": "string"
            }
          ]
        }
      }
    },
    "substitution": {
      "type": "SEQ",
      "members": [
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "STRING",
              "value": "${"
            },
            {
              "type": "FIELD",
              "name": "optional",
              "content": {
                "type": "STRING",
                "value": "${?"
              }
            }
          ]
        },
        {
          "type": "FIELD",
          "name": "path",
          "content": {
            "type": "SYMBOL",
            "name": "path"
          }
        },
        {
          "type": "STRING",
          "value": "}"
        }
      ]
    },
    "include": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "include"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "_include_target"
            },
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "FIELD",
                  "name": "required",
                  "content": {
                    "type": "STRING",
                    "value": "required"
                  }
                },
                {
                  "type": "STRING",
                  "value": "("
                },
                {
                  "type": "SYMBOL",
                  "name": "_include_target"
                },
                {
                  "type": "STRING",
                  "value": ")"
                }
              ]
            }
          ]
        }
      ]
    },
    "_include_target": {
      "type": "CHOICE",
      "members": [
        {
          "type": "FIELD",
          "name": "resource",
          "content": {
            "type": "SYMBOL",
            "name": "string"
          }
        },
        {
          "type": "SEQ",
          "members": [
            {
              "type": "FIELD",
              "name": "kind",
              "content": {
                "type": "CHOICE",
                "members": [
                  {
                    "type": "STRING",
                    "value": "url"
                  },
                  {
                    "type": "STRING",
                    "value": "file"
                  },
                  {
                    "type": "STRING",
                    "value": "classpath"
                  }
                ]
              }
            },
            {
              "type": "STRING",
              "value": "("
            },
            {
              "type": "FIELD",
              "name": "resource",
              "content": {
                "type": "SYMBOL",
                "name": "string"
              }
            },
            {
              "type": "STRING",
              "value": ")"
            }
          ]
        }
      ]
    },
    "string": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "\""
          },
          {
            "type": "REPEAT",
            "content": {
              "type": "CHOICE",
              "members": [
                {
                  "type": "PATTERN",
                  "value": "[^\"\\\\\\n]"
                },
                {
                  "type": "PATTERN",
                  "value": "\\\\[^\\n]"
                }
              ]
            }
          },
          {
            "type": "STRING",
            "value": "\""
          }
        ]
      }
    },
    "multiline_string": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "\"\"\""
          },
          {
            "type": "REPEAT",
            "content": {
              "type": "CHOICE",
              "members": [
                {
                  "type": "PATTERN",
                  "value": "[^\"]"
                },
                {
                  "type": "PATTERN",
                  "value": "\"[^\"]"
                },
                {
                  "type": "PATTERN",
                  "value": "\"\"[^\"]"
                }
              ]
            }
          },
          {
            "type": "PATTERN",
            "value": "\"\"\"+"
          }
        ]
      }
    },
    "number": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 1,
        "content": {
          "type": "PATTERN",
          "value": "-?(0|[1-9][0-9]*)(\\.[0-9]+)?([eE][+-]?[0-9]+)?"
        }
      }
    },
    "true": {
      "type": "STRING",
      "value": "true"
    },
    "false": {
      "type": "STRING",
      "value": "false"
    },
    "null": {
      "type": "STRING",
      "value": "null"
    },
    "unquoted_string": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "([^$\"{}\\[\\]:=,+#`^?!@*&\\\\ \\t\\n\\r\\f\\v\\u00a0\\ufeff\\u2028\\u2029/]|\\/[^$\"{}\\[\\]:=,+#`^?!@*&\\\\ \\t\\n\\r\\f\\v\\u00a0\\ufeff\\u2028\\u2029/])+|\\/"
      }
    },
    "unquoted_key": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "([^$\"{}\\[\\]:=,+#`^?!@*&\\\\ \\t\\n\\r\\f\\v\\u00a0\\ufeff\\u2028\\u2029/.]|\\/[^$\"{}\\[\\]:=,+#`^?!@*&\\\\ \\t\\n\\r\\f\\v\\u00a0\\ufeff\\u2028\\u2029/.])+|\\/"
      }
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "[ \\t\\n\\r\\f\\v\\u00a0\\ufeff\\u2028\\u2029]"
    },
    {
      "type": "SYMBOL",
      "name": "comment"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [
    {
      "type": "SYMBOL",
      "name": "_newline"
    },
    {
      "type": "SYMBOL",
      "name": "_error_sentinel"
    }
  ],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}